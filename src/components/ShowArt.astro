---
// Podcast artwork from the feed, or a branded stand-in tile when a feed has none.
import TowerMark from './TowerMark.astro';
interface Props { show: string; image?: string | null; size?: number }
const { show, image, size = 120 } = Astro.props;
const palettes = [
  ['#006747', '#ffffff'],
  ['#cfc493', '#00382a'],
  ['#00382a', '#cfc493'],
  ['#eef4f0', '#006747'],
];
const h = [...show].reduce((a, c) => a + c.charCodeAt(0), 0) % palettes.length;
const [bg, fg] = palettes[h];
const words = show.replace(/^the\s+/i, '').split(/\s+/).slice(0, 3).join(' ');
---
<span class="art" style={`width:${size}px;height:${size}px;background:${bg};color:${fg}`}>
  <span class="fb"><TowerMark size={Math.round(size * 0.34)} /><span class="nm">{words}</span></span>
  {image && (
    <img src={image} alt="" loading="lazy" decoding="async" width={size} height={size} referrerpolicy="no-referrer" onerror="this.remove()" />
  )}
</span>
<style>
  .art {
    flex: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: grid;
    place-items: center;
    position: relative;
    container-type: size;
  }
  /* A hairline edge, so white cover art does not dissolve into the page. */
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line);
    pointer-events: none;
  }
  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    text-align: center;
  }
  /* The stand-in tile scales with the tile, which shrinks on phones. */
  .fb :global(svg) {
    width: auto;
    height: 30cqh;
  }
  .nm {
    font-family: var(--serif);
    font-size: clamp(0.6875rem, 11cqw, 1rem);
    line-height: 1.1;
  }
</style>
