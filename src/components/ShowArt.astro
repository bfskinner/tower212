---
// Podcast artwork from the feed, or a branded stand-in tile when a feed has none.
import TowerMark from './TowerMark.astro';
interface Props { show: string; image?: string | null; size?: number }
const { show, image, size = 120 } = Astro.props;
const palettes = [
  ['#006747', '#ffffff'],
  ['#cfc493', '#00382a'],
  ['#00382a', '#cfc493'],
  ['#eef4f0', '#006747'],
];
const h = [...show].reduce((a, c) => a + c.charCodeAt(0), 0) % palettes.length;
const [bg, fg] = palettes[h];
const words = show.replace(/^the\s+/i, '').split(/\s+/).slice(0, 3).join(' ');
---
<span class="art" style={`width:${size}px;height:${size}px;background:${bg};color:${fg}`}>
  <span class="fb"><TowerMark size={Math.round(size * 0.34)} /><span class="nm">{words}</span></span>
  {image && (
    <img src={image} alt="" loading="lazy" decoding="async" width={size} height={size} referrerpolicy="no-referrer" onerror="this.remove()" />
  )}
</span>
<style>
  .art {
    flex: none;
    border-radius: 0.4rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    position: relative;
  }
  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem;
    text-align: center;
  }
  .nm {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.15;
  }
</style>
