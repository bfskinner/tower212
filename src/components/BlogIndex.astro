---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import PageHead from './PageHead.astro';
import PostGrid from './PostGrid.astro';
import { img, srcset } from '../lib/img';
import { fmt } from '../lib/site';
interface Props { category?: string }
const { category } = Astro.props;
const all = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const cats = [...new Set(all.map((p) => p.data.category))];
const list = category ? all.filter((p) => p.data.category === category) : all;
const [feat, ...rest] = list;
export const slug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<PageHead eyebrow="Tower 212 originals" title="From the" italic="tower." sub="Notes from 212 feet.">
  {cats.length > 1 && (
    <div class="chips">
      <a class="chip" href="/blog/" aria-current={!category ? 'true' : undefined}>All posts</a>
      {cats.map((c) => <a class="chip" href={`/blog/category/${slug(c)}/`} aria-current={c === category ? 'true' : undefined}>{c}</a>)}
    </div>
  )}
</PageHead>

{feat && (
  <section class="wrap feat-wrap">
    <a class="tile feat" href={`/blog/${feat.id}/`}>
      <div class="img"><img src={img(feat.data.cover, 1600)} srcset={srcset(feat.data.cover)} sizes="(max-width: 900px) 100vw, 58vw" alt="" /></div>
      <div class="txt">
        <div class="meta"><span class="cat">{feat.data.category}</span></div>
        <h2 class="t">{feat.data.title}</h2>
        {feat.data.excerpt && <p>{feat.data.excerpt}</p>}
        <span class="by">By Tower 212 · {fmt.post(feat.data.date)}</span>
        <span class="btn btn-primary" style="align-self:flex-start">Read article <Icon name="arrow" /></span>
      </div>
    </a>
  </section>
)}

{rest.length > 0 && <section class="wrap sec"><h2 class="h-sub more-h">More from the <em>tower.</em></h2><PostGrid posts={rest} /></section>}
{!feat && <section class="wrap sec"><p>No posts yet.</p></section>}

<style>
  .feat-wrap {
    padding-top: 2rem;
  }
  .feat {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .feat .img {
    aspect-ratio: 4 / 3;
    border-radius: 0.5rem;
  }
  .more-h {
    margin-bottom: 1.5rem;
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .txt .t {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .by {
    color: var(--green);
    font-size: 0.95rem;
  }
  .txt p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }
  @media (max-width: 900px) {
    .feat {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
