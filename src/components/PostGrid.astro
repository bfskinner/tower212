---
import { img, srcset } from '../lib/img';
import { fmt } from '../lib/site';
interface Props { posts: any[] }
const { posts } = Astro.props;
---
<div class="grid">
  {posts.map((p) => (
    <a class="tile" href={`/blog/${p.id}/`}>
      <div class="img"><img src={img(p.data.cover, 960)} srcset={srcset(p.data.cover)} sizes="(max-width: 700px) 100vw, 33vw" alt="" loading="lazy" /></div>
      <div class="meta"><span class="cat">{p.data.category}</span> · {fmt.postShort(p.data.date)}</div>
      <div class="t">{p.data.title}</div>
    </a>
  ))}
</div>
<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 1.75rem;
  }
  .img {
    aspect-ratio: 16 / 10.5;
  }
  .t {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
