---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { news, sources, feeds } from '../lib/feeds';
import { fmt } from '../lib/site';
const names = [...new Set(news.map((n) => n.source))];
---
<Base title="The Wire" description="USF coverage from the sources you follow, gathered automatically every hour. Every link goes to the original.">
  <PageHead eyebrow="External coverage" title="The" italic="Wire." sub="USF coverage, from the sources you follow." />
  <div class="wrap">
    <div class="bar">
      <div class="chips" role="group" aria-label="Filter by source">
        <button class="chip" type="button" aria-current="true" data-filter="">All sources</button>
        {names.map((n) => <button class="chip" type="button" data-filter={n}>{n}</button>)}
      </div>
      <span class="note">Updated {fmt.date(feeds.updatedAt)} · refreshes hourly</span>
    </div>
    <div class="cols">
      <div>
        <h2 class="h-sub">Latest coverage</h2>
        <ul class="list">
          {news.map((n: any) => (
            <li class="it" data-src={n.source}>
              <a href={n.link} rel="noopener" target="_blank">
                <span class="txt">
                  <span class="meta"><span class="cat">{n.source}</span> · {fmt.short(n.date)}</span>
                  <span class="t">{n.title}</span>
                  <span class="out">Read at source <Icon name="out" size={13} /></span>
                </span>
                {n.image && <img src={n.image} alt="" loading="lazy" />}
              </a>
            </li>
          ))}
        </ul>
        {news.length === 0 && <p>Headlines arrive here every hour.</p>}
      </div>
      <aside class="side panel">
        <h2 class="h-sub sm">Sources</h2>
        <ul>
          {sources.news.map((s) => <li><a href={s.link ?? s.feed} rel="noopener" target="_blank">{s.name} <Icon name="out" size={12} /></a></li>)}
        </ul>
        <hr class="rule" />
        <div class="more"><span class="mt">Explore more voices</span><a class="out" href="/usf-media/">USF Media directory <Icon name="arrow" size={13} /></a></div>
        <p class="fine">If a source's feed is down, its last available stories stay listed until it returns.</p>
      </aside>
    </div>
  </div>
</Base>
<script>
  for (const c of document.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
    c.addEventListener('click', () => {
      const f = c.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach((x) => x.removeAttribute('aria-current'));
      c.setAttribute('aria-current', 'true');
      document.querySelectorAll<HTMLElement>('[data-src]').forEach((e) => (e.hidden = !!f && e.dataset.src !== f));
    });
  }
</script>
<style>
  .bar {
    margin-top: 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .chips button {
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    background: var(--white);
    border: 1px solid var(--line);
    font-weight: 500;
  }
  .chips button[aria-current='true'] {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }
  .note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 17rem;
    gap: 2.5rem;
    padding-top: 1.75rem;
  }
  .list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .it[hidden] {
    display: none;
  }
  .it a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .meta .cat {
    color: var(--deep);
  }
  .t {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.1;
  }
  .it a:hover .t {
    color: var(--green);
  }
  .it img {
    width: 14rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0.4rem;
  }
  .side {
    align-self: start;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sm {
    font-size: 2rem;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .side li a {
    color: var(--deep);
    text-decoration: none;
    font-size: 1.05rem;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .side li a:hover {
    color: var(--green);
    text-decoration: underline;
  }
  .mt {
    display: block;
    font-family: var(--serif);
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }
  .fine {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .it a {
      grid-template-columns: 1fr;
    }
    .it img {
      width: 100%;
      grid-row: 1;
    }
  }
</style>
