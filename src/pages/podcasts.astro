---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import ShowArt from '../components/ShowArt.astro';
import { podcasts, sources } from '../lib/feeds';
import { fmt } from '../lib/site';
const shows = [...new Set(podcasts.map((p) => p.show))];
const artFor = (name: string) => podcasts.find((p) => p.show === name && p.image)?.image ?? null;
---
<Base title="Podcasts" description="New episodes from USF podcasts, gathered automatically every hour. Listen here or at the source.">
  <PageHead eyebrow="Podcasts" title="Around the" italic="mic." sub="Conversations from across Bulls country." />
  <div class="wrap">
    <div class="bar">
      <div class="chips" role="group" aria-label="Filter by show">
        <button class="chip" type="button" aria-current="true" data-filter="">All shows</button>
        {shows.map((s) => <button class="chip" type="button" data-filter={s}>{s}</button>)}
      </div>
    </div>

    <div class="player panel" id="player" hidden>
      <button class="pp" type="button" aria-label="Play or pause" data-toggle><Icon name="play" size={16} /></button>
      <div class="pt"><div class="meta" data-show></div><div class="pn" data-title></div></div>
      <audio controls preload="none" data-audio></audio>
    </div>

    <div class="cols">
      <div>
        <h2 class="h-sub">Latest episodes</h2>
        <ul class="list">
          {podcasts.map((p) => (
            <li class="ep" data-show={p.show}>
              <ShowArt show={p.show} image={p.image} size={92} />
              <div class="txt">
                <span class="meta cat">{p.show}</span>
                <a class="t" href={p.link} rel="noopener" target="_blank">{p.title}</a>
                <span class="d">{fmt.short(p.date)}{p.duration && ` · ${p.duration}`}</span>
              </div>
              <div class="acts">
                {p.audio && <button class="btn btn-primary btn-sm play" type="button" data-src={p.audio} data-t={p.title} data-s={p.show}><Icon name="play" size={11} />Play</button>}
                <a class="out" href={p.link} rel="noopener" target="_blank">Listen at source <Icon name="out" size={13} /></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <aside class="side">
        <h2 class="h-sub sm">Find your next <em>listen.</em></h2>
        {sources.podcasts.map((s) => (
          <a class="show" href={s.link} rel="noopener" target="_blank">
            <ShowArt show={s.name} image={artFor(s.name)} size={96} />
            <span><span class="sn">{s.name}</span><span class="out">View show <Icon name="out" size={12} /></span></span>
          </a>
        ))}
        <hr class="rule" />
        <div><span class="mt">More voices, one directory.</span><a class="out" href="/usf-media/">Explore USF Media <Icon name="arrow" size={13} /></a></div>
      </aside>
    </div>
  </div>
</Base>
<script>
  const player = document.getElementById('player')!;
  const audio = player.querySelector<HTMLAudioElement>('[data-audio]')!;
  for (const b of document.querySelectorAll<HTMLButtonElement>('button.play')) {
    b.addEventListener('click', () => {
      player.hidden = false;
      player.querySelector('[data-title]')!.textContent = b.dataset.t!;
      player.querySelector('[data-show]')!.textContent = 'Now playing · ' + b.dataset.s;
      audio.src = b.dataset.src!;
      audio.play().catch(() => {});
    });
  }
  player.querySelector('[data-toggle]')!.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
  for (const c of document.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
    c.addEventListener('click', () => {
      const f = c.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach((x) => x.removeAttribute('aria-current'));
      c.setAttribute('aria-current', 'true');
      document.querySelectorAll<HTMLElement>('.ep').forEach((e) => (e.hidden = !!f && e.dataset.show !== f));
    });
  }
</script>
<style>
  .bar {
    margin-top: 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .chips button {
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    background: var(--white);
    border: 1px solid var(--line);
    font-weight: 500;
  }
  .chips button[aria-current='true'] {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }
  .player {
    position: sticky;
    top: 5.75rem;
    z-index: 10;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    box-shadow: 0 12px 30px rgba(0, 56, 42, 0.12);
  }
  .player[hidden] {
    display: none;
  }
  .pp {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 0;
    background: var(--green);
    color: var(--white);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .pt {
    flex: 1 1 14rem;
    min-width: 0;
  }
  .pn {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .player audio {
    flex: 1 1 18rem;
    height: 2.5rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 3rem;
    padding-top: 1.75rem;
  }
  .list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .ep {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ep[hidden] {
    display: none;
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .cat {
    color: var(--deep);
  }
  .t {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }
  .t:hover {
    color: var(--green);
  }
  .d {
    font-size: 0.9rem;
    color: var(--green);
  }
  .acts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-left: 2rem;
    border-left: 1px solid var(--line);
    align-self: start;
  }
  .sm {
    font-size: 2.1rem;
  }
  .show {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .sn {
    display: block;
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }
  .mt {
    display: block;
    font-family: var(--serif);
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  @media (max-width: 960px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .side {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 600px) {
    .ep {
      grid-template-columns: auto 1fr;
    }
    .ep :global(.art) {
      width: 4.5rem !important;
      height: 4.5rem !important;
    }
    .acts {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
    .t {
      font-size: 1.3rem;
    }
  }
</style>
