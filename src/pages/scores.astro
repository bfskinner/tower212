---
import Base from '../layouts/Base.astro';
import Matchday from '../components/Matchday.astro';
import { games, nextGame, vs, record, schedule } from '../lib/schedule';
import { fmt } from '../lib/site';
---
<Base title="Scores & Schedule" description="USF football results, the next kickoff, and the full schedule. Updates itself.">
  <section class="wrap head">
    <div class="eyebrow">Football · {schedule.season}</div>
    <h1 class="display">Scores &amp; <em>schedule.</em></h1>
    <p class="mono note">{record() ? `Record ${record()}` : ''}{schedule.standing ? ` · ${schedule.standing}` : ''} · Updated {fmt.date(schedule.updatedAt)}</p>
  </section>
  <section class="wrap" style="padding-top:2rem"><Matchday showStrip={false} /></section>
  <section class="wrap sec">
    <h2 class="h-sub" style="margin-bottom:1.25rem">Full season.</h2>
    <div class="table" role="table" aria-label={`${schedule.season} schedule`}>
      {games.map((g) => (
        <div class:list={['tr', g === nextGame && 'nx']} role="row">
          <div class="c date" role="cell">{fmt.day(g.date)}</div>
          <div class="c opp" role="cell"><span class="o">{vs(g)}</span>{g.conference && <span class="conf">American</span>}<span class="v">{g.venue}{g.city && ` · ${g.city}`}</span></div>
          <div class="c tv mono" role="cell">{g.tv}</div>
          <div class="c res mono" role="cell">
            {g.state === 'post' && g.usScore != null ? <span class:list={['r', g.result === 'L' && 'l']}>{g.result} {g.usScore}–{g.themScore}</span>
             : g.state === 'post' ? <span class="r">Final</span>
             : g.state === 'in' ? <span class="live">Live · {g.usScore}–{g.themScore}</span>
             : g.timeTBD ? 'TBA' : fmt.time(g.date)}
          </div>
        </div>
      ))}
    </div>
    <p class="src">Data from ESPN, refreshed every hour. Times are Eastern.</p>
  </section>
</Base>
<style>
  .head {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .head h1 {
    font-size: clamp(3rem, 7vw, 6rem);
  }
  .note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .table {
    border-top: 1px solid var(--line);
  }
  .tr {
    display: grid;
    grid-template-columns: 11rem 1fr 8rem 9rem;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .tr.nx {
    background: var(--paper);
    border-radius: 0.5rem;
  }
  .date {
    font-weight: 600;
  }
  .opp {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: baseline;
  }
  .o {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .conf {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    background: rgba(0, 103, 71, 0.1);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }
  .v {
    flex-basis: 100%;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tv {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .res {
    text-align: right;
    font-size: 0.85rem;
  }
  .r {
    color: var(--green);
    font-weight: 500;
  }
  .r.l {
    color: var(--muted);
  }
  .live {
    color: var(--white);
    background: var(--green);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }
  .src {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .tr {
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
    }
    .date {
      grid-column: 1;
      font-size: 0.85rem;
      color: var(--muted);
      font-weight: 500;
    }
    .opp {
      grid-column: 1;
    }
    .tv {
      display: none;
    }
    .res {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
