---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { img, srcset } from '../../lib/img';
import { fmt, readingTime, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, next: posts[i + 1] ?? null } }));
}
const { post, next } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, SITE.url).href;
const share = `https://x.com/intent/post?${new URLSearchParams({ text: `${post.data.title} via @${SITE.x}`, url })}`;
---
<Base title={post.data.title} description={post.data.excerpt} image={post.data.cover} type="article">
  <article>
    <header class="wrap ah">
      <a class="meta" href="/blog/"><span class="cat">{post.data.category}</span> · {fmt.post(post.data.date)} · {readingTime(post.body)} min read</a>
      <h1 class="display">{post.data.title}</h1>
      <div class="by">
        <span>By USF Water Tower</span>
        <span class="bar"></span>
        <a href={share} rel="noopener" target="_blank"><Icon name="x" size={13} />Share</a>
      </div>
    </header>
    {post.data.cover && (
      <div class="wrap"><div class="cover"><img src={img(post.data.cover, 1600)} srcset={srcset(post.data.cover)} sizes="100vw" alt="" fetchpriority="high" /></div></div>
    )}
    <div class="wrap"><div class="prose"><Content /></div></div>
    <div class="wrap">
      <div class="foot">
        <a class="chip" href="/blog/">{post.data.category}</a>
        {next && <a class="more" href={`/blog/${next.id}/`}>Next: {next.data.title} <Icon name="arrow" /></a>}
      </div>
    </div>
  </article>

  <section class="talk">
    <div class="wrap row">
      <div>
        <div class="eyebrow">Talk about it</div>
        <p class="lead">The conversation happens on X and Discord, not here.</p>
        <p class="sub">The X button opens a post with this link and @{SITE.x} already filled in.</p>
      </div>
      <div class="acts">
        <a class="btn btn-ink" href={share} rel="noopener" target="_blank"><Icon name="x" size={14} />Discuss on X</a>
        {SITE.discord && <a class="btn btn-outline" href={SITE.discord} rel="noopener" target="_blank">USF fan Discord</a>}
        <button class="btn btn-outline copy" type="button" data-url={url} aria-label="Copy link"><Icon name="link" /><span>Copy link</span></button>
      </div>
    </div>
  </section>
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('.copy')) {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url!);
        const s = b.querySelector('span');
        if (s) { s.textContent = 'Copied'; setTimeout(() => (s.textContent = 'Copy link'), 1800); }
      } catch {}
    });
  }
</script>

<style>
  .ah {
    padding-top: clamp(3rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  .ah .meta {
    text-decoration: none;
  }
  .ah h1 {
    max-width: 62rem;
    font-size: clamp(2.6rem, 5.5vw, 4rem);
    line-height: 1.02;
  }
  .by {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .by a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    text-decoration: none;
  }
  .bar {
    width: 1px;
    height: 1.1rem;
    background: var(--line);
  }
  .cover {
    margin-top: 2rem;
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    background: var(--paper);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prose {
    max-width: 47.5rem;
    margin: 3rem auto 0;
    font-size: 1.1875rem;
    line-height: 1.7;
  }
  .prose :global(p:first-child) {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.4;
    color: var(--deep);
  }
  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.1;
    margin: 2.5rem 0 0.5rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 0.25rem;
  }
  .prose :global(img) {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    height: auto;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--gold);
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--deep);
  }
  .prose :global(li) {
    margin: 0.35rem 0;
  }
  .foot {
    max-width: 47.5rem;
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .talk {
    margin-top: 3rem;
    background: var(--paper);
    margin-bottom: calc(-1 * var(--section));
  }
  .talk .row {
    max-width: calc(47.5rem + 2 * var(--gutter));
    padding-block: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
  }
  .lead {
    margin: 0.35rem 0 0.15rem;
    font-weight: 600;
  }
  .sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .acts {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
</style>
